# Dockerfile.backend
FROM python:3.11-slim

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# รัน DR Calculation API (port 8002)
# เปลี่ยน working directory ไปที่ API เพื่อให้ import ง่ายขึ้น
WORKDIR /app/API
CMD ["uvicorn", "dr_calculation_api:app", "--host", "0.0.0.0", "--port", "8002"]
